# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Encrypts GitHub access tokens at rest (AES-256-GCM). Required — sign-in
# fails closed (no token stored) if unset or the wrong length.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Optional: HMAC key for signed SVG README badges (defaults to NEXTAUTH_SECRET)
BADGE_SIGNING_KEY=

# GitHub org slug for maintainer dashboard access (e.g. "stellar" or your org name)
GITHUB_MAINTAINER_ORG=

# Optional: GitHub team slug within GITHUB_MAINTAINER_ORG. When set, a user
# must belong to both the org AND this team to be treated as a maintainer.
# Unset (default) keeps the org-only check, same as today.
GITHUB_MAINTAINER_TEAM=

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
# Runtime app role. URL-encode the org slug in the options value.
# Migrations must use a separate trustbridge_migrator URL; see
# docs/PRISMA_POOL_TUNING.md.
DATABASE_URL=postgresql://trustbridge_app:password@localhost:5432/trustbridge?schema=public&options=-c%20app.maintainer_org_id%3Ddefault

# ---------------------------------------------------------------------------
# Stellar network + asset
#
# These four values MUST match the defaults in trustbridge-action's action.yml
# (horizon_url / asset_code / asset_issuer / min_xlm_reserve). If they drift,
# a contributor can read as "ready" on the dashboard and still fail the Action
# that gates their payout. The dashboard's network panel warns when the
# resolved values disagree. See docs/ENVIRONMENT.md.
# ---------------------------------------------------------------------------

# Stellar Horizon API (mainnet or testnet). Action default: same value.
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Default asset to check for trustline readiness.
# Circle USDC on Stellar mainnet — matches the Action's asset_issuer default.
NEXT_PUBLIC_DEFAULT_ASSET_CODE=USDC
NEXT_PUBLIC_DEFAULT_ASSET_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Minimum spendable XLM balance considered "ready" (Stellar base reserve +
# headroom). Matches the Action's min_xlm_reserve default. Setting this LOWER
# than the Action's value is what produces "ready here, fails there".
NEXT_PUBLIC_MIN_XLM_BALANCE=1.5

# Stellar network base reserve in XLM, used to compute each account's minimum
# reserve (baseReserve * (2 + subentries + sponsoring - sponsored))
NEXT_PUBLIC_BASE_RESERVE_XLM=0.5

# Optional: Soroban contract ID for on-chain registry (future). Also
# required for the dashboard's Soroban event timeline panel.
SOROBAN_CONTRACT_ID=

# Optional: Soroban RPC endpoint used by the event timeline panel.
# Defaults to https://soroban-testnet.stellar.org if unset.
# Keep on the same network as NEXT_PUBLIC_HORIZON_URL above — a mismatch
# (e.g. leaving both unset) is detected and surfaced on the dashboard.
SOROBAN_RPC_URL=

# Optional: TTL in milliseconds for the /api/check KV response cache.
# Defaults to 120000 (2 minutes). Set to a positive integer to override.
# Transient Horizon errors are never cached regardless of this value.
CHECK_CACHE_TTL_MS=

# Optional: "live" (default) or "synced". Reported as `registryMode` by the
# contributor REST endpoints. Reads are identical either way — this only
# signals whether a scheduled contract-sync job (vs. manual maintainer
# rechecks) is expected to be keeping Postgres fresh.
REGISTRY_MODE=

# Optional: Bearer token for automated cron triggers (/api/contract-sync, /api/cron/export)
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Optional: Destination email address for automated nightly treasury CSV exports
TREASURY_EXPORT_EMAIL=

